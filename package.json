{
  "name": "tecno-cosecha",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace agrícola móvil para conectar productores agrícolas con compradores en República Dominicana",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node -e 'const { runMigrations } = require(\"./dist/db\"); runMigrations();'",
    "db:seed": "node -e 'const { runSeeds } = require(\"./dist/db\"); runSeeds();'",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}

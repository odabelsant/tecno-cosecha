# ==============================================================================
# TECNO COSECHA — VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# ==============================================================================
# INSTRUCCIONES:
# Copia este archivo a `.env.local` para desarrollo local:
#   cp .env.example .env.local
# NUNCA agregues valores con contraseñas o secretos reales a este archivo.
# ==============================================================================

# Entorno de ejecución (development | test | production)
NODE_ENV=development

# Puerto del servidor
PORT=3000

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de datos (SQLite local para desarrollo / PostgreSQL para producción)
DATABASE_URL=file:./dev.db

# Nivel de registro de logs (debug | info | warn | error)
LOG_LEVEL=info
